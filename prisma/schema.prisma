// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Data model mirrors "Comic Script Writer - MVP Plan.md" §4.
// User / ProjectMember / Asset / Event exist now as schema seams for the
// future team/production feature (§7) but are unused by MVP logic.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  projectMemberships ProjectMember[]
  uploadedAssets     Asset[]
  events             Event[]
  ownedScripts       Script[]
  artVersions        ArtVersion[]
  artComments        ArtComment[]
}

enum Role {
  OWNER
  COLLABORATOR
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  scripts     Script[]
  castMembers CastMember[]
  members     ProjectMember[]
  invites     Invite[]
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      Role   @default(COLLABORATOR)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// V2 D3: a pending project membership. The owner invites by email, which mints
/// a token (the shareable link). Claimed when someone signs up / logs in with
/// the matching email — until an email provider lands (Resend), the email match
/// is the proof; afterward the token becomes the real proof. One open invite per
/// (project, email); accepting creates the ProjectMember and flips status.
model Invite {
  id        String       @id @default(cuid())
  projectId String
  email     String
  role      Role         @default(COLLABORATOR)
  token     String       @unique @default(cuid())
  status    InviteStatus @default(PENDING)
  invitedBy String
  createdAt DateTime     @default(now())
  acceptedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
}

model CastMember {
  id        String  @id @default(cuid())
  projectId String
  name      String
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Script {
  id         String    @id @default(cuid())
  projectId  String?
  title      String
  author     String
  draftLabel String
  draftDate  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  // Locked = the read view (references shown/placed, no text editing).
  // Unlocked = the editor. The mode switch for the whole reference layer (V2 C).
  locked     Boolean   @default(false)
  // The script's owner (V2 D). Access = ownerId is me OR I'm a member of its
  // project. Nullable only for the backfill window; new scripts always set it.
  ownerId    String?

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner       User?        @relation(fields: [ownerId], references: [id])
  pages       Page[]
  snapshots   Snapshot[]
  references  Reference[]
  collections Collection[]
  artPages    ArtPage[]
}

enum PageKind {
  SCRIPT
  BLANK
}

model Page {
  id       String   @id @default(cuid())
  scriptId String
  order    Int
  // SCRIPT: the numbered comic page (panels/notes). BLANK: a freeform document
  // page (plain paragraphs) that's skipped by page numbering. A blank page
  // stores its paragraphs as ordered NOTE items — same run-serialized text
  // columns, no extra table.
  kind     PageKind @default(SCRIPT)
  // True when the writer explicitly started this page (New page / Ctrl+Enter)
  // rather than it being created by overflow. Auto-pagination never pulls
  // content back up across a manual break, so a deliberate page stays put even
  // when the previous page has room. Overflow-created pages default to false.
  manualBreak Boolean @default(false)

  script Script     @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  items  PageItem[]
  assets Asset[]

  @@unique([scriptId, order])
}

enum PageItemType {
  NOTE
  PANEL
}

model PageItem {
  id       String       @id @default(cuid())
  pageId   String
  order    Int
  type     PageItemType
  noteText String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  panel Panel?

  @@unique([pageId, order])
}

model Panel {
  id          String @id @default(cuid())
  pageItemId  String @unique
  description String

  pageItem     PageItem           @relation(fields: [pageItemId], references: [id], onDelete: Cascade)
  textElements PanelTextElement[]
}

enum PanelTextElementType {
  DIALOGUE
  CAPTION
  SFX
  NARRATION
}

model PanelTextElement {
  id        String               @id @default(cuid())
  panelId   String
  order     Int
  type      PanelTextElementType
  character String?
  modifier  String?
  text      String

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, order])
}

model Snapshot {
  id        String   @id @default(cuid())
  scriptId  String
  label     String?
  isManual  Boolean  @default(false)
  createdAt DateTime @default(now())
  content   String

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

/// V2 Phase E — art pipeline. One row per script page that has (or had) art.
/// Deliberately keyed by (scriptId, pageNumber), NOT Page.id: the editor
/// wipes-and-recreates Page rows on every save, so Page.id is unstable (same
/// reasoning as ReferencePlacement). Lock the script before art starts so page
/// numbers stay frozen under the uploaded art; a later edit that drops the page
/// orphans its art (pageNumber past the end) rather than corrupting it.
/// NB: this supersedes the unused `Asset.kind = ART` seam, which pinned to the
/// unstable pageId. Art bytes live in a dedicated R2 bucket (ART_R2_*), never in
/// Postgres — unlike reference images, which are AssetData blobs.
model ArtPage {
  id         String   @id @default(cuid())
  scriptId   String
  pageNumber Int
  createdAt  DateTime @default(now())
  // The version shown/downloaded as "current". Nullable while a page row exists
  // with no live version. SetNull so deleting the pointed-at version never
  // cascades the ArtPage away.
  currentVersionId String? @unique

  script         Script       @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  currentVersion ArtVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ArtVersion[] @relation("PageVersions")
  comments       ArtComment[]

  @@unique([scriptId, pageNumber])
}

/// One uploaded art file for a page = one immutable version. `version`
/// increments per ArtPage. Bytes stored in R2 at
/// art/<scriptId>/p<pageNumber>/v<version>/original.<ext>, with a generated
/// preview.webp; storageKey/previewKey hold those object keys. Owner-only hard
/// delete of a NON-current version removes this row + its R2 objects (an Event
/// records the deletion so history survives even though the file doesn't).
model ArtVersion {
  id           String   @id @default(cuid())
  artPageId    String
  version      Int
  storageKey   String
  previewKey   String?
  // Web-preview lifecycle. Browser-renderable uploads (PNG/JPG/WEBP) are READY
  // at once (previewKey = storageKey). PSD/TIFF/PDF land PENDING and the
  // art-preview-worker (a separate Railway service) rasterizes a preview.webp,
  // then flips this to READY (or FAILED). SKIP LOCKED on PENDING is the queue.
  previewStatus PreviewStatus @default(READY)
  // Optional "what changed" note for this version, editable from the timeline.
  note         String?
  bytes        Int?
  mime         String?
  originalName String?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  artPage    ArtPage  @relation("PageVersions", fields: [artPageId], references: [id], onDelete: Cascade)
  currentFor ArtPage? @relation("CurrentVersion")
  uploader   User?    @relation(fields: [uploadedBy], references: [id])

  @@unique([artPageId, version])
  @@index([previewStatus])
}

enum PreviewStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A note pinned to a spot on a page's art (the prototype's comment pins).
/// Anchored by xPct/yPct (0–1 fractions) on the ArtPage — resolution-independent
/// and version-independent: notes persist across new uploads. Authored by any
/// project member; resolvable/reopenable, hard-deletable by the author.
model ArtComment {
  id         String    @id @default(cuid())
  artPageId  String
  authorId   String?
  body       String
  xPct       Float
  yPct       Float
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  artPage ArtPage @relation(fields: [artPageId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id])
}

enum AssetKind {
  REFERENCE
  ART
}

/// Backs both the future art pipeline (`kind = ART`, pinned to a Page) and
/// V2 reference images (`kind = REFERENCE`, owned by a Project via Reference,
/// no Page). `pageId`/`uploadedBy` are nullable because a reference has no page
/// and — until Phase D auth exists — no user. Don't reintroduce a required
/// uploader here; route ownership through the current-user accessor instead.
model Asset {
  id           String    @id @default(cuid())
  pageId       String?
  uploadedBy   String?
  storageKey   String
  note         String?
  kind         AssetKind @default(ART)
  mime         String?
  bytes        Int?
  originalName String?
  thumbKey     String?
  createdAt    DateTime  @default(now())

  page      Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploader  User?      @relation(fields: [uploadedBy], references: [id])
  reference Reference?
  data      AssetData?
}

/// Blob store for small reference images, kept in Postgres so uploads survive
/// Railway's ephemeral filesystem without an object store (§3: "a simple upload
/// path is fine for v1"). Split from Asset so the bytes never load unless a
/// query asks for them. The future 20–250 MB art pipeline uses R2, not this.
model AssetData {
  assetId String @id
  data    Bytes

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// V2 Reference Library (see V2-Roadmap.md §2–3). Single-user for now.
/// A reference = one image (Asset) + an optional caption, scoped to a Script
/// (an issue): each issue carries its own reference set (project-hub decision
/// 2026-08-31 — references live per issue, not per series).
model Reference {
  id        String   @id @default(cuid())
  scriptId  String
  assetId   String   @unique
  caption   String?
  createdAt DateTime @default(now())

  script      Script                  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  asset       Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  collections ReferenceInCollection[]
  placements  ReferencePlacement[]
}

/// A free-form tag/group ("Bone", "The Cathedral", "1890s streetwear") within a
/// single issue's reference set. Read "Collection" as "tag": many-to-many,
/// user-defined per issue (§5).
model Collection {
  id       String @id @default(cuid())
  scriptId String
  name     String

  script     Script                  @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  references ReferenceInCollection[]

  @@unique([scriptId, name])
}

model ReferenceInCollection {
  referenceId  String
  collectionId String

  reference  Reference  @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([referenceId, collectionId])
}

/// Pins a reference to a spot on a script page in the read view (V2 C).
/// Anchored by page NUMBER + an x/y percentage of the page — deliberately NOT
/// by Page.id/Panel.id, which are regenerated on every save (the editor
/// wipes-and-recreates pages). A locked script freezes page numbers, so pins
/// stay put; a late edit that drops the page just orphans the placement
/// (pageNumber past the end) — the reference is kept, the link severed.
/// x/y are 0–1 fractions so they're resolution-independent.
model ReferencePlacement {
  id          String   @id @default(cuid())
  referenceId String
  pageNumber  Int
  xPct        Float
  yPct        Float
  createdAt   DateTime @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
}

/// Future: append-only activity log. Not read anywhere in the MVP, but
/// written to from day one where cheap, since unlogged history can never
/// be reconstructed later.
model Event {
  id        String   @id @default(cuid())
  type      String
  subjectId String
  actorId   String
  meta      String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
