// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Data model mirrors "Comic Script Writer - MVP Plan.md" §4.
// User / ProjectMember / Asset / Event exist now as schema seams for the
// future team/production feature (§7) but are unused by MVP logic.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  projectMemberships ProjectMember[]
  uploadedAssets     Asset[]
  events             Event[]
}

enum Role {
  OWNER
  COLLABORATOR
}

model Project {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  scripts     Script[]
  castMembers CastMember[]
  members     ProjectMember[]
  references  Reference[]
  collections Collection[]
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      Role   @default(COLLABORATOR)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model CastMember {
  id        String  @id @default(cuid())
  projectId String
  name      String
  notes     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Script {
  id         String    @id @default(cuid())
  projectId  String?
  title      String
  author     String
  draftLabel String
  draftDate  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pages     Page[]
  snapshots Snapshot[]
}

enum PageKind {
  SCRIPT
  BLANK
}

model Page {
  id       String   @id @default(cuid())
  scriptId String
  order    Int
  // SCRIPT: the numbered comic page (panels/notes). BLANK: a freeform document
  // page (plain paragraphs) that's skipped by page numbering. A blank page
  // stores its paragraphs as ordered NOTE items — same run-serialized text
  // columns, no extra table.
  kind     PageKind @default(SCRIPT)
  // True when the writer explicitly started this page (New page / Ctrl+Enter)
  // rather than it being created by overflow. Auto-pagination never pulls
  // content back up across a manual break, so a deliberate page stays put even
  // when the previous page has room. Overflow-created pages default to false.
  manualBreak Boolean @default(false)

  script Script     @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  items  PageItem[]
  assets Asset[]

  @@unique([scriptId, order])
}

enum PageItemType {
  NOTE
  PANEL
}

model PageItem {
  id       String       @id @default(cuid())
  pageId   String
  order    Int
  type     PageItemType
  noteText String?

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  panel Panel?

  @@unique([pageId, order])
}

model Panel {
  id          String @id @default(cuid())
  pageItemId  String @unique
  description String

  pageItem     PageItem             @relation(fields: [pageItemId], references: [id], onDelete: Cascade)
  textElements PanelTextElement[]
  placements   ReferencePlacement[]
}

enum PanelTextElementType {
  DIALOGUE
  CAPTION
  SFX
  NARRATION
}

model PanelTextElement {
  id        String               @id @default(cuid())
  panelId   String
  order     Int
  type      PanelTextElementType
  character String?
  modifier  String?
  text      String

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, order])
}

model Snapshot {
  id        String   @id @default(cuid())
  scriptId  String
  label     String?
  isManual  Boolean  @default(false)
  createdAt DateTime @default(now())
  content   String

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

enum AssetKind {
  REFERENCE
  ART
}

/// Backs both the future art pipeline (`kind = ART`, pinned to a Page) and
/// V2 reference images (`kind = REFERENCE`, owned by a Project via Reference,
/// no Page). `pageId`/`uploadedBy` are nullable because a reference has no page
/// and — until Phase D auth exists — no user. Don't reintroduce a required
/// uploader here; route ownership through the current-user accessor instead.
model Asset {
  id           String    @id @default(cuid())
  pageId       String?
  uploadedBy   String?
  storageKey   String
  note         String?
  kind         AssetKind @default(ART)
  mime         String?
  bytes        Int?
  originalName String?
  thumbKey     String?
  createdAt    DateTime  @default(now())

  page      Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  uploader  User?      @relation(fields: [uploadedBy], references: [id])
  reference Reference?
  data      AssetData?
}

/// Blob store for small reference images, kept in Postgres so uploads survive
/// Railway's ephemeral filesystem without an object store (§3: "a simple upload
/// path is fine for v1"). Split from Asset so the bytes never load unless a
/// query asks for them. The future 20–250 MB art pipeline uses R2, not this.
model AssetData {
  assetId String @id
  data    Bytes

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// V2 Reference Library (see V2-Roadmap.md §2–3). Additive; single-user for now.
/// A reference = one image (Asset) + an optional caption, owned by a Project.
model Reference {
  id        String   @id @default(cuid())
  projectId String
  assetId   String   @unique
  caption   String?
  createdAt DateTime @default(now())

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset       Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  collections ReferenceInCollection[]
  placements  ReferencePlacement[]
}

/// A free-form tag/group ("Bone", "The Cathedral", "1890s streetwear").
/// Read "Collection" as "tag": many-to-many, user-defined per issue (§5).
model Collection {
  id        String @id @default(cuid())
  projectId String
  name      String

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  references ReferenceInCollection[]

  @@unique([projectId, name])
}

model ReferenceInCollection {
  referenceId  String
  collectionId String

  reference  Reference  @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([referenceId, collectionId])
}

/// Pins a reference to a specific Panel (stable Panel.id — §2.2). A reference
/// can be pinned to several panels; a panel can hold several references.
model ReferencePlacement {
  id          String   @id @default(cuid())
  referenceId String
  panelId     String
  createdAt   DateTime @default(now())

  reference Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  panel     Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([referenceId, panelId])
}

/// Future: append-only activity log. Not read anywhere in the MVP, but
/// written to from day one where cheap, since unlogged history can never
/// be reconstructed later.
model Event {
  id        String   @id @default(cuid())
  type      String
  subjectId String
  actorId   String
  meta      String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
