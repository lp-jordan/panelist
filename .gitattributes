# Shell scripts must stay LF — a CRLF shebang (`#!/bin/sh\r`) fails to execute
# in the Linux backup container.
*.sh text eol=lf
backup/Dockerfile text eol=lf

# The art-preview-worker also builds/runs in a Linux container — keep its
# Dockerfile and worker script LF so line continuations and the runtime behave.
art-preview-worker/Dockerfile text eol=lf
art-preview-worker/*.mjs text eol=lf
