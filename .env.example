# PostgreSQL connection string. On Railway, add a Postgres service and it injects
# this automatically; locally, point it at your own Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Used once by `npx prisma db seed` to create the single owner account.
OWNER_NAME=""
OWNER_EMAIL=""
OWNER_PASSWORD=""
