# PostgreSQL connection string. On Railway, add a Postgres service and it injects
# this automatically; locally, point it at your own Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Used once by `npx prisma db seed` to create the owner account (sign in with a
# code emailed to OWNER_EMAIL — there are no passwords).
OWNER_NAME=""
OWNER_EMAIL=""

# Passwordless sign-in + invite emails, sent through Resend.
# Without RESEND_API_KEY, emails (including sign-in codes) are written to the
# server log instead of sent — fine for local dev.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Panelist <howdy@panelist.renownedcomic.com>"
# Public origin for links in emails. Required in production for magic links;
# without it, production emails carry the code only.
APP_URL="https://panelist.renownedcomic.com"
